const E={};
function build(pg,cells,pre,ex){
 const all=cells.map((c,i)=>[...c,pre+i]);(ex||[]).forEach(c=>all.push([c[0],c[1],c[2],c[3],c[4],c[5]]));
 all.sort((a,b)=>Math.round(a[1]/5)-Math.round(b[1]/5)||a[0]-b[0]);
 const els=[];
 all.forEach((c,n)=>{const e=document.createElement('input');e.style.cssText=`left:${c[0]}px;top:${c[1]}px;width:${c[2]}px;height:${c[3]}px;font-size:${Math.max(7,Math.min(10,c[3]-3))}px`;
  e.value=S[c[4]]||'';E[c[4]]=e;els.push(e);e.autocomplete='off';
  if(c[5]=='tg'){e.readOnly=true;e.className='tg';e.onclick=()=>{e.value=e.value?'':'X';S[c[4]]=e.value;sv_()}}
  else{if(c[2]<16)e.maxLength=1;e.oninput=()=>{S[c[4]]=e.value;sv_();if(c[2]<16&&e.value&&els[n+1])els[n+1].focus()}}
  pg.appendChild(e)});
}
